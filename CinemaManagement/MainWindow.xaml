<Window x:Class="CinemaManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CinemaManagement.Views"
        Title="Cinema Management - Group 2"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B">
            <Grid Margin="25,0">
                <TextBlock Text="CINEMA MANAGEMENT"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBlock Text="GROUP 2 - PRN212"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1"
                    Margin="15"
                    FontSize="15">

            <TabItem Header="Showtimes">
                <views:ShowtimesView/>
            </TabItem>

            <TabItem Header="Movies">
                <views:ManageMoviesView/>
            </TabItem>

            <TabItem Header="Rooms &amp; Seats">
                <views:RoomsSeatsView/>
            </TabItem>

            <TabItem Header="Booking">
                <views:BookingView/>
            </TabItem>

            <TabItem Header="Payments">
                <views:PaymentsView/>
            </TabItem>

            <TabItem Header="Account">
                <views:AccountView/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
