<Window x:Class="CinemaManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CinemaManagement.Views"
        Title="Cinema Management - Group 2"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1E293B">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CINEMA MANAGEMENT"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentUserText"
                               Foreground="White" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Sign Out" Click="SignOutButton_Click"
                            Padding="14,7" Background="#EF4444"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="15" FontSize="15">
            <TabItem x:Name="BrowseMoviesTab" Header="Browse Movies">
                <views:BrowseMoviesView/>
            </TabItem>
            <TabItem x:Name="ShowtimesTab" Header="Showtimes">
                <views:ShowtimesView x:Name="ShowtimesControl" />
            </TabItem>
            <TabItem x:Name="ManageMoviesTab" Header="Manage Movies">
                <views:ManageMoviesView/>
            </TabItem>
            <TabItem x:Name="RoomsSeatsTab" Header="Rooms &amp; Seats">
                <views:RoomsSeatsView/>
            </TabItem>
            <TabItem x:Name="BookingTab" Header="Booking">
                <views:BookingView x:Name="BookingControl"/>
            </TabItem>
            <TabItem x:Name="ViewBookingTab" Header="View Booking">
                <views:ViewBookingView x:Name="ViewBookingControl"/>
            </TabItem>
            <TabItem x:Name="CustomerProfileTab" Header="My Profile">
                <views:CustomerProfileView x:Name="CustomerProfileControl"/>
            </TabItem>
            <TabItem x:Name="PaymentsTab" Header="Payments">
                <views:PaymentsView/>
            </TabItem>
            <TabItem x:Name="AccountTab" Header="Account">
                <views:AccountView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>