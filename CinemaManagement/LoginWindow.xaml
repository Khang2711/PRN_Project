<Window x:Class="CinemaManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In - Cinema Management"
        Height="560" Width="900"
        MinHeight="560" MinWidth="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>

        <!-- Left brand panel, matching the application's navy header -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid Margin="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="9"
                            Background="#2563EB" VerticalAlignment="Center">
                        <TextBlock Text="C" Foreground="White" FontSize="25"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CINEMA MANAGEMENT" Foreground="White"
                               FontSize="17" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="WELCOME BACK"
                               Foreground="#93C5FD" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock Text="Your movie&#10;experience starts here."
                               Foreground="White" FontSize="31"
                               FontWeight="Bold" TextWrapping="Wrap"
                               LineHeight="39"/>
                    <TextBlock Text="Sign in to browse movies, view showtimes, and manage your bookings."
                               Foreground="#CBD5E1" FontSize="15"
                               TextWrapping="Wrap" Margin="0,18,0,0"
                               LineHeight="24"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="GROUP 2  •  PRN212"
                           Foreground="#94A3B8" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Sign-in form -->
        <Grid Grid.Column="1" Margin="48,40">
            <Border Background="White" CornerRadius="12" Padding="34"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="20"
                                      ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Sign In" FontSize="29"
                               FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Enter your account details to continue."
                               FontSize="14" Foreground="#64748B"
                               Margin="0,8,0,28" TextWrapping="Wrap"/>

                    <TextBlock Text="Username" Foreground="#334155"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameTextBox" Height="42"
                             Padding="12,8" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBD5E1" BorderThickness="1"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Password" Foreground="#334155"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="PasswordBox" Height="42"
                                 Padding="12,8" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 Margin="0,0,0,8"/>

                    <TextBlock x:Name="ErrorText" Foreground="#DC2626"
                               FontSize="13" TextWrapping="Wrap"
                               MinHeight="22" Margin="0,0,0,10"/>

                    <Button Content="Sign In" Height="44"
                            Click="SignInButton_Click"
                            Background="#2563EB" Foreground="White"
                            FontSize="15" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Demo accounts: admin / admin123  •  user / user123"
                               Foreground="#64748B" FontSize="11"
                               TextWrapping="Wrap" Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>