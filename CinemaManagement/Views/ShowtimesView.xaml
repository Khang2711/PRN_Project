<UserControl x:Class="CinemaManagement.Views.ShowtimesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaManagement.ViewModels"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ShowtimesViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="SHOWTIME SCHEDULE"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock
                Text="View movie showtimes and ticket information"
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,0"/>
        </StackPanel>

        <!-- TOOLBAR -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SHOWTIME LIST"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <!-- ONLY ADMIN CAN SEE ADD BUTTON -->
                <Button Grid.Column="1"
                        Content="+ Add Showtime"
                        Width="150"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Visibility="{Binding CanManageShowtimes,
                            Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding ShowCreateFormCommand}"/>
            </Grid>
        </Border>

        <!-- F23: CREATE SHOWTIME FORM -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15"
                Visibility="{Binding IsCreateFormVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel>

                <TextBlock Text="CREATE NEW SHOWTIME"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MOVIE NAME -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,15">

                        <TextBlock Text="Movie Name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBox
                            Height="35"
                            Padding="8,5"
                            FontSize="14"
                            Text="{Binding MovieName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- ROOM NAME -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,10,15">

                        <TextBlock Text="Room Name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBox
                            Height="35"
                            Padding="8,5"
                            FontSize="14"
                            Text="{Binding RoomName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- SHOWTIME DATE -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,10,15">

                        <TextBlock Text="Showtime Date"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <DatePicker
                            Height="35"
                            SelectedDate="{Binding SelectedDate,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- START TIME -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="3"
                                Margin="0,0,0,15">

                        <TextBlock Text="Start Time"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <ComboBox
                            Height="35"
                            FontSize="14"
                            ItemsSource="{Binding Times}"
                            SelectedItem="{Binding SelectedTime,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- DURATION -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Duration (Minutes)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBox
                            Height="35"
                            Padding="8,5"
                            FontSize="14"
                            Text="{Binding DurationText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- TICKET PRICE -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Ticket Price (VND)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBox
                            Height="35"
                            Padding="8,5"
                            FontSize="14"
                            Text="{Binding PriceText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- AUTOMATIC END TIME -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Grid.ColumnSpan="2">

                        <TextBlock Text="End Time (Automatic)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <Border Background="#DCFCE7"
                                CornerRadius="5"
                                Height="35"
                                Padding="10,0">

                            <TextBlock
                                Text="{Binding EndTimePreview}"
                                Foreground="#166534"
                                FontSize="14"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- FORM BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Cancel"
                            Width="100"
                            Height="38"
                            Margin="0,0,10,0"
                            Background="#E2E8F0"
                            Foreground="#334155"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ShowCreateFormCommand}"/>

                    <Button Content="Save Showtime"
                            Width="150"
                            Height="38"
                            Background="#16A34A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CreateShowtimeCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- F24: SHOWTIME LIST -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="15">

            <DataGrid
                ItemsSource="{Binding Showtimes}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                RowHeight="45"
                ColumnHeaderHeight="45"
                FontSize="14"
                BorderThickness="0"
                Background="White"
                AlternatingRowBackground="#F1F5F9">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding ShowtimeId}"
                        Width="50"/>

                    <DataGridTextColumn
                        Header="Movie"
                        Binding="{Binding Movie.Title}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Room"
                        Binding="{Binding Room.RoomName}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Start Time"
                        Binding="{Binding StartTime,
                            StringFormat=dd/MM/yyyy HH:mm}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Duration (min)"
                        Binding="{Binding Movie.DurationMinutes}"
                        Width="115"/>

                    <DataGridTextColumn
                        Header="End Time"
                        Binding="{Binding EndTime,
                            StringFormat=dd/MM/yyyy HH:mm}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Price (VND)"
                        Binding="{Binding TicketPrice,
                            StringFormat=N0}"
                        Width="110"/>

                    <DataGridCheckBoxColumn
                        Header="Active"
                        Binding="{Binding IsActive, Mode=OneWay}"
                        Width="100"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
