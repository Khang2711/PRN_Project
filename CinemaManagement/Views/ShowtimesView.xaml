    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SHOWTIME MANAGEMENT"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Manage movie showtimes and ticket prices"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SHOWTIME LIST"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+ Add Showtime"
                        Width="150"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Showtime Table -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="15">

            <DataGrid ItemsSource="{Binding Showtimes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="45"
                      ColumnHeaderHeight="45"
                      FontSize="14"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F1F5F9">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding ShowtimeId}"
                        Width="60"/>

                    <DataGridTextColumn
                        Header="Movie"
                        Binding="{Binding MovieTitle}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Room"
                        Binding="{Binding RoomName}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Start Time"
                        Binding="{Binding StartTime,
                            StringFormat=dd/MM/yyyy HH:mm}"
                        Width="155"/>

                    <DataGridTextColumn
                        Header="End Time"
                        Binding="{Binding EndTime,
                            StringFormat=dd/MM/yyyy HH:mm}"
                        Width="155"/>

                    <DataGridTextColumn
                        Header="Price (VND)"
                        Binding="{Binding TicketPrice,
                            StringFormat=N0}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        Width="110"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
