<Window x:Class="CinemaManagement.Views.SeatAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem ghế và đặt ghế" Height="650" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="580" MinWidth="700" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="XEM GHẾ &amp; ĐẶT GHẾ" FontSize="23" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="{Binding MovieTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,6,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding RoomName}"/>
                <TextBlock Text="  |  "/>
                <TextBlock Text="{Binding SelectedShowtime.StartTime, StringFormat='dd/MM/yyyy HH:mm'}"/>
                <TextBlock Text="  |  "/>
                <TextBlock Text="{Binding SelectedShowtime.TicketPrice, StringFormat='{}{0:N0} VND/ghế'}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="18" Height="18" CornerRadius="4" Background="#16A34A" Margin="0,0,6,0"/>
            <TextBlock Text="Còn trống" Margin="0,0,18,0"/>
            <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB" Margin="0,0,6,0"/>
            <TextBlock Text="Đang chọn" Margin="0,0,18,0"/>
            <Border Width="18" Height="18" CornerRadius="4" Background="#E2E8F0" Margin="0,0,6,0"/>
            <TextBlock Text="Đã đặt"/>
        </StackPanel>

        <Border Grid.Row="2" Height="30" Background="#CBD5E1" CornerRadius="5" Margin="35,0,35,15">
            <TextBlock Text="MÀN HÌNH CHIẾU" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Seats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="65" Height="52" Margin="5" Padding="2"
                                        Click="Seat_Click" CommandParameter="{Binding}"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#16A34A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SeatCode}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SeatType}" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Phòng này chưa có ghế đang hoạt động." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" IsHitTestVisible="False"
                           Visibility="{Binding HasNoSeats, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Đã chọn: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedSeats}" Margin="0,0,15,0"/>
                <TextBlock Text="Tổng tiền: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N0} VND'}" Foreground="#2563EB" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Tải lại ghế" Width="100" Height="34" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="Đặt ghế" Width="100" Height="34" Background="#2563EB" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Click="Book_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#2563EB" Margin="0,10,0,0"/>
    </Grid>
</Window>
