<UserControl x:Class="CinemaManagement.Views.ViewBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VIEW BOOKING" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{Binding Username, StringFormat='Customer: {0}'}"
                           Margin="0,8,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="↻  Refresh"
                    Click="RefreshButton_Click"
                    Width="110"
                    Height="36"
                    Margin="15,0,0,0"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding MyBookings.Count, StringFormat='Bookings: {0}'}"
                   Margin="0,0,0,15"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding MyBookings}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeight="38" ColumnHeaderHeight="38"
                  AlternatingRowBackground="#F1F5F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Booking Code" Binding="{Binding BookingCode}" Width="150"/>
                <DataGridTextColumn Header="Movie" Binding="{Binding Showtime.Movie.Title}" Width="*"/>
                <DataGridTextColumn Header="Showtime" Binding="{Binding Showtime.StartTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="145"/>
                <DataGridTextColumn Header="Seats" Binding="{Binding SeatSummary}" Width="120"/>
                <DataGridTextColumn Header="Total (VND)" Binding="{Binding TotalAmount, StringFormat='N0'}" Width="120"/>
                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>