<UserControl x:Class="CinemaManagement.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <Grid Margin="25">
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="28" MaxWidth="650"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="BOOKING GUIDE" FontSize="24" FontWeight="Bold"
                           Foreground="#1E293B" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding Username, StringFormat='Customer: {0}'}"
                           Foreground="#64748B" Margin="0,0,0,18"/>
                <TextBlock Text="How to book a ticket" FontSize="18"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="1. Open Browse Movies and choose a movie."
                           Margin="0,0,0,8"/>
                <TextBlock Text="2. Select a showtime, then click Chọn ghế."
                           Margin="0,0,0,8"/>
                <TextBlock Text="3. Click the available seats you want. Selected seats turn blue."
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="4. Review the total and click Đặt vé. Your booking will be saved as Pending / Unpaid."
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="5. Go to View Booking to see your booking code and ticket details. Pay at the counter to confirm the booking."
                           TextWrapping="Wrap" Foreground="#2563EB"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>