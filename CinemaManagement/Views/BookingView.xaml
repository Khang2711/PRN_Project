<UserControl x:Class="CinemaManagement.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock Text="CREATE BOOKING"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,15"/>

            <!-- SHOWTIME INFORMATION -->
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="{Binding Username,
                            StringFormat='Customer: {0}'}"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.Movie.Title,
                            StringFormat='Movie: {0}',
                            FallbackValue='Movie: -'}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.Room.RoomName,
                            StringFormat='Room: {0}',
                            FallbackValue='Room: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.StartTime,
                            StringFormat='Start: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='Start: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.EndTime,
                            StringFormat='End: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='End: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.TicketPrice,
                            StringFormat='Price per seat: {0:N0} VND',
                            FallbackValue='Price per seat: -'}"
                        Margin="0,0,0,15"/>

                    <Separator Margin="0,5,0,15"/>

                    <!-- Seats are selected in SeatAvailabilityWindow, not in this summary. -->
                    <TextBlock Text="BOOKING SUMMARY"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                                        <!-- BOOKING SUMMARY -->
                    <Border Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,20,0,15">

                        <StackPanel>

                            <TextBlock
                                Text="{Binding SelectedSeatLabels,
                                    StringFormat='Selected seats: {0}'}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,8"/>

                            <TextBlock
                                Text="{Binding SelectedSeatCount,
                                    StringFormat='Number of seats: {0}'}"
                                Margin="0,0,0,8"/>

                            <TextBlock
                                Text="{Binding TotalPrice,
                                    StringFormat='Total: {0:N0} VND'}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#1D4ED8"/>

                        </StackPanel>

                    </Border>

                    <!-- CONFIRM -->
                    <Button Content="Confirm Booking"
                            Command="{Binding ConfirmBookingCommand}"
                            Padding="18,10"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#2563EB"
                               Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>