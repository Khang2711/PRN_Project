<UserControl x:Class="CinemaManagement.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock Text="CREATE BOOKING"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,15"/>

            <!-- SHOWTIME INFORMATION -->
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="{Binding Username,
                            StringFormat='Customer: {0}'}"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.Movie.Title,
                            StringFormat='Movie: {0}',
                            FallbackValue='Movie: -'}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.Room.RoomName,
                            StringFormat='Room: {0}',
                            FallbackValue='Room: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.StartTime,
                            StringFormat='Start: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='Start: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.EndTime,
                            StringFormat='End: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='End: -'}"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.TicketPrice,
                            StringFormat='Price per seat: {0:N0} VND',
                            FallbackValue='Price per seat: -'}"
                        Margin="0,0,0,15"/>

                    <Separator Margin="0,5,0,15"/>

                    <!-- SEAT SELECTION -->
                    <TextBlock Text="SELECT YOUR SEATS"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- SEAT LEGEND -->
                    <WrapPanel Margin="0,0,0,15">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,20,5">

                            <Border Width="18"
                                    Height="18"
                                    Background="#16A34A"
                                    CornerRadius="3"
                                    Margin="0,0,6,0"/>

                            <TextBlock Text="Available"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,20,5">

                            <Border Width="18"
                                    Height="18"
                                    Background="#DC2626"
                                    CornerRadius="3"
                                    Margin="0,0,6,0"/>

                            <TextBlock Text="Booked"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,20,5">

                            <Border Width="18"
                                    Height="18"
                                    Background="#2563EB"
                                    CornerRadius="3"
                                    Margin="0,0,6,0"/>

                            <TextBlock Text="Selected"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </WrapPanel>

                    <!-- SCREEN -->
                    <Border Background="#CBD5E1"
                            CornerRadius="5"
                            Height="30"
                            Margin="30,0,30,20">

                        <TextBlock Text="SCREEN"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#334155"/>

                    </Border>

                    <!-- SEAT LIST -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">

                        <ItemsControl ItemsSource="{Binding Seats}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="65"
                                            Height="48"
                                            Margin="5"
                                            Padding="3"
                                            Content="{Binding SeatCode}"
                                            ToolTip="{Binding SeatType}"

                                            Command="{Binding DataContext.ToggleSeatCommand,
                                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"

                                            CommandParameter="{Binding}">

                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">

                                                <Setter Property="Background"
                                                        Value="#16A34A"/>

                                                <Setter Property="Foreground"
                                                        Value="White"/>

                                                <Setter Property="FontWeight"
                                                        Value="Bold"/>

                                                <Setter Property="BorderThickness"
                                                        Value="0"/>

                                                <Setter Property="Cursor"
                                                        Value="Hand"/>

                                                <Style.Triggers>

                                                    <!-- SELECTED -->
                                                    <DataTrigger
                                                        Binding="{Binding IsSelected}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#2563EB"/>

                                                    </DataTrigger>

                                                    <!-- BOOKED: RED HAS PRIORITY -->
                                                    <DataTrigger
                                                        Binding="{Binding IsBooked}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#DC2626"/>

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="White"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Button.Style>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Border>

                    <!-- BOOKING SUMMARY -->
                    <Border Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,20,0,15">

                        <StackPanel>

                            <TextBlock
                                Text="{Binding SelectedSeatCount,
                                    StringFormat='Selected seats: {0}'}"
                                Margin="0,0,0,8"/>

                            <TextBlock
                                Text="{Binding AvailableSeatCount,
                                    StringFormat='Available seats: {0}'}"
                                Margin="0,0,0,8"/>

                            <TextBlock
                                Text="{Binding TotalPrice,
                                    StringFormat='Total: {0:N0} VND'}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#1D4ED8"/>

                        </StackPanel>

                    </Border>

                    <!-- CONFIRM -->
                    <Button Content="Confirm Booking"
                            Command="{Binding ConfirmBookingCommand}"
                            Padding="18,10"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#2563EB"
                               Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>