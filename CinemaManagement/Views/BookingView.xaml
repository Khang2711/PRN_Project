<UserControl x:Class="CinemaManagement.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25"
                    MaxWidth="700"
                    HorizontalAlignment="Left">

            <TextBlock Text="BOOKING"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="{Binding Username,
                            StringFormat='Customer: {0}'}"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.MovieTitle,
                            StringFormat='Movie: {0}',
                            FallbackValue='Movie: -'}"
                        FontSize="18"
                        FontWeight="Bold"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.RoomName,
                            StringFormat='Room: {0}',
                            FallbackValue='Room: -'}"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.StartTime,
                            StringFormat='Start: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='Start: -'}"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.EndTime,
                            StringFormat='End: {0:dd/MM/yyyy HH:mm}',
                            FallbackValue='End: -'}"
                        Margin="0,0,0,12"/>

                    <TextBlock
                        Text="{Binding SelectedShowtime.TicketPrice,
                            StringFormat='Price / seat: {0:N0} VND',
                            FallbackValue='Price / seat: -'}"
                        Margin="0,0,0,12"/>

                    <TextBlock Text="Seat: Not selected"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Payment: Unpaid"
                               Margin="0,0,0,20"/>

                    <TextBlock
                        Text="Seat selection will be added later. This booking does not reserve a seat."
                        TextWrapping="Wrap"
                        Foreground="Gray"
                        Margin="0,0,0,15"/>

                    <Button Content="Confirm Booking"
                            Command="{Binding ConfirmBookingCommand}"
                            HorizontalAlignment="Left"
                            Padding="20,10"/>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Foreground="#2563EB"
                               Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>