<UserControl x:Class="CinemaManagement.Views.RoomsSeatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaManagement.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="#F5F6FA">
    
    
    <UserControl.DataContext>
        <vm:RoomsSeatsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="ROOM MANAGEMENT"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="View screening rooms and seating capacity"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ROOM LIST"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Total rooms: "
                               FontSize="14"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Rooms.Count}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#334155"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="15">

            <DataGrid ItemsSource="{Binding Rooms}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="45"
                      ColumnHeaderHeight="45"
                      FontSize="14"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F1F5F9">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding RoomId}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Room Name"
                                        Binding="{Binding RoomName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Total Seats"
                                        Binding="{Binding TotalSeats}"
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>