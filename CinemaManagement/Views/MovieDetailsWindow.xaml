<Window x:Class="CinemaManagement.Views.MovieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaManagement.Views"
        mc:Ignorable="d"
        Title="Movie Details" Height="600" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="MOVIE DETAILS"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto">

                <StackPanel>


                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <Border Width="145"
                                Height="205"
                                Background="#E2E8F0"
                                CornerRadius="5">

                            <Grid>

                                <TextBlock
                                    Text="Chưa có poster"
                                    Foreground="#64748B"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Image Source="{Binding PosterUrl}"
                                       Stretch="Uniform"
                                       Width="140"
                                       Height="200"/>

                            </Grid>
                        </Border>

                        <StackPanel Margin="15,0,0,0"
                                    Width="390">

                            <TextBlock Text="{Binding Title}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#1E293B"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Movie ID"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding MovieId}"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="Genre"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Genre,
                                       TargetNullValue='Chưa cập nhật'}"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="Duration"
                                       FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">

                                <TextBlock
                                    Text="{Binding DurationMinutes}"/>

                                <TextBlock Text=" minutes"/>

                            </StackPanel>

                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,0,0,15"/>


                    <TextBlock Text="Description"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,5"/>

                    <TextBlock
                        Text="{Binding Description,
                               TargetNullValue='Chưa có mô tả'}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,15"/>

                    <TextBlock Text="Age Rating"
                               FontWeight="SemiBold"/>

                    <TextBlock
                        Text="{Binding AgeRating,
                               TargetNullValue='Chưa cập nhật'}"
                        Margin="0,4,0,12"/>


                    <TextBlock Text="Release Date"
                               FontWeight="SemiBold"/>

                    <TextBlock
                        Text="{Binding ReleaseDate,
                               TargetNullValue='Chưa cập nhật'}"
                        Margin="0,4,0,12"/>


                    <TextBlock Text="Language"
                               FontWeight="SemiBold"/>

                    <TextBlock
                        Text="{Binding Language,
                               TargetNullValue='Chưa cập nhật'}"
                        Margin="0,4,0,12"/>

                </StackPanel>
            </ScrollViewer>
        </Border>


        <Button Grid.Row="2"
                Content="Đóng"
                Width="110"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Background="#64748B"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"/>

    </Grid>
</Window>
