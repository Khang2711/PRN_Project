<UserControl x:Class="CinemaManagement.Views.BookingDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,15">

            <Button Content="← Back to Booking List"
                    Width="190"
                    Height="38"
                    Command="{Binding BackToBookingListCommand}"/>

            <TextBlock Text="BOOKING DETAILS"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

        </DockPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- BOOKING INFORMATION -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="BOOKING INFORMATION"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding SelectedBooking.BookingCode,
                                           StringFormat='Booking Code: {0}'}"
                                       FontWeight="SemiBold"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SelectedBooking.BookingTimeText,
                                           StringFormat='Booking Date: {0}'}"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding SelectedBooking.MovieTitle,
                                           StringFormat='Movie: {0}'}"
                                       TextWrapping="Wrap"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedBooking.RoomName,
                                           StringFormat='Room: {0}'}"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="{Binding SelectedBooking.ShowtimeText,
                                           StringFormat='Showtime: {0}'}"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedBooking.SeatCodes,
                                           StringFormat='Seats: {0}'}"
                                       TextWrapping="Wrap"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="{Binding SelectedBooking.Status,
                                           StringFormat='Booking Status: {0}'}"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding SelectedBooking.PaymentStatus,
                                           StringFormat='Payment Status: {0}'}"
                                       Margin="0,8"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="{Binding SelectedBooking.TotalAmount,
                                           StringFormat='Total Amount: {0:N0} VND'}"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       Margin="0,8"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- SEAT DETAILS -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="SEAT DETAILS"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <DataGrid
                            ItemsSource="{Binding SelectedBooking.SeatDetails}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            RowHeight="35"
                            ColumnHeaderHeight="35"
                            MaxHeight="220"
                            GridLinesVisibility="Horizontal"
                            AlternatingRowBackground="#F1F5F9">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Seat"
                                    Binding="{Binding SeatCode}"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="Seat Type"
                                    Binding="{Binding SeatType}"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="Price"
                                    Binding="{Binding PriceAtBooking,
                                        StringFormat={}{0:N0}}"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="Status"
                                    Binding="{Binding Status}"
                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

                <!-- BOOKING ACTIONS -->
                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="BOOKING ACTIONS"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">

                            <Button Content="Cancel Booking"
                                    Command="{Binding CancelBookingCommand}"
                                    Width="150"
                                    Height="40"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"/>

                        </StackPanel>

                        <TextBlock Text="{Binding CancellationNotice}"
                                   Foreground="#B91C1C" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding BookingsMessage}"
                                   Foreground="#2563EB"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
