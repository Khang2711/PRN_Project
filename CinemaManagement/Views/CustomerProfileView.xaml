<UserControl x:Class="CinemaManagement.Views.CustomerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25" MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="MY PROFILE" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <Border Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock Text="Account information" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <TextBlock Text="Username" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameTextBox" IsReadOnly="True" Background="#F1F5F9" Padding="10" Margin="0,0,0,14"/>
                    <TextBlock Text="Full name" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameTextBox" Padding="10" Margin="0,0,0,14"/>
                    <TextBlock Text="Email" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailTextBox" Padding="10" Margin="0,0,0,14"/>
                    <TextBlock Text="Phone" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="PhoneTextBox" Padding="10" Margin="0,0,0,14"/>
                    <TextBlock Text="Role" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="RoleTextBox" IsReadOnly="True" Background="#F1F5F9" Padding="10" Margin="0,0,0,18"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#DC2626" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EditButton" Content="Edit Profile" Click="EditButton_Click" Padding="18,9" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton" Content="Save Changes" Click="SaveButton_Click" Padding="18,9" Background="#16A34A" Foreground="White" BorderThickness="0" Visibility="Collapsed" Margin="0,0,10,0"/>
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Padding="18,9" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>