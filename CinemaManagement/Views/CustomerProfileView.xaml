<UserControl x:Class="CinemaManagement.Views.CustomerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F9">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="ProfileTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#E53945"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="MY PROFILE" FontSize="25" FontWeight="Bold"
                               Foreground="#172033"/>
                    <TextBlock Text="Manage your personal information and account details."
                               FontSize="13" Foreground="#7B8798" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Profile content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Identity card -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16"
                        Padding="25" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Width="76" Height="76" CornerRadius="38"
                                Background="#E53945" HorizontalAlignment="Left"
                                Margin="0,2,0,20">
                            <TextBlock Text="👤" FontSize="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ACCOUNT OVERVIEW" Foreground="#AAB6C8"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProfileNameText" Text="{Binding DisplayName}"
                                   Foreground="White" FontSize="21"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProfileUsernameText" Text="{Binding DisplayUsername}"
                                   Foreground="#CBD5E1" FontSize="13"
                                   Margin="0,5,0,22" TextWrapping="Wrap"/>
                        <Border Height="1" Background="#3B4759" Margin="0,0,0,18"/>
                        <TextBlock Text="ACCOUNT TYPE" Foreground="#94A3B8"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                        <Border Background="#344256" CornerRadius="8"
                                Padding="10,8" HorizontalAlignment="Left">
                            <TextBlock x:Name="ProfileRoleText" Text="{Binding DisplayRole}"
                                       Foreground="White" FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="Your username and account type cannot be changed here."
                                   Foreground="#AAB6C8" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,22,0,0"
                                   LineHeight="17"/>
                    </StackPanel>
                </Border>

                <!-- Details card -->
                <Border Grid.Column="2" Background="White" CornerRadius="16"
                        Padding="28" BorderBrush="#E8ECF2" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="Personal information" FontSize="18"
                                           FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="Keep your contact details up to date."
                                           FontSize="12" Foreground="#94A3B8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameTextBox" Text="{Binding Username, Mode=OneWay}" Style="{StaticResource ProfileTextBox}"
                                 IsReadOnly="True" Background="#F1F5F9"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="FullNameTextBox" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProfileTextBox}"
                                 IsReadOnly="{Binding IsNotEditing}" Margin="0,0,0,18"/>

                        <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProfileTextBox}"
                                 IsReadOnly="{Binding IsNotEditing}" Margin="0,0,0,18"/>

                        <TextBlock Text="PHONE NUMBER" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PhoneTextBox" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProfileTextBox}"
                                 IsReadOnly="{Binding IsNotEditing}" Margin="0,0,0,18"/>

                        <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RoleTextBox" Text="{Binding Role, Mode=OneWay}" Style="{StaticResource ProfileTextBox}"
                                 IsReadOnly="True" Background="#F1F5F9"
                                 Margin="0,0,0,20"/>

                        <Border Background="#FFF7F7" CornerRadius="8" Padding="12"
                                Margin="0,0,0,18">
                            <TextBlock Text="For your security, username and role are read-only."
                                       Foreground="#A64B52" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="ForestGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="EditButton" Content="Edit profile"
                                    Command="{Binding EditCommand}"
                                    Visibility="{Binding IsNotEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="SaveButton" Content="Save changes"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0"/>
                            <Button x:Name="CancelButton" Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>