<UserControl x:Class="CinemaManagement.Views.AccountView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="MANAGE USERS" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>
        <TabControl Grid.Row="1" FontSize="14">
            <TabItem Header="Create User">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="Create User Account" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,17"/>
                        <TextBlock Text="Full Name"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,5,0,12"/>
                        <TextBlock Text="Username"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,5,0,12"/>
                        <TextBlock Text="Email (optional)"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,5,0,12"/>
                        <TextBlock Text="Phone (optional)"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,5,0,12"/>
                        <TextBlock Text="Password (at least 6 characters)"/>
                        <PasswordBox x:Name="NewPasswordBox" Height="32" Margin="0,5,0,12"/>
                        <TextBlock Text="Role"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Height="32" Margin="0,5,0,18"/>
                        <Button Content="Create User" Click="CreateUser_Click" Background="#2563EB" Foreground="White" Padding="20,10" HorizontalAlignment="Left" BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="User Accounts">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="User Accounts" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Background="#2563EB" Foreground="White" Padding="15,7" Margin="20,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="36" ColumnHeaderHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="55"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="Change role:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Width="120" Height="34"/>
                        <Button Content="Save Role" Command="{Binding ChangeRoleCommand}" Background="#2563EB" Foreground="White" Padding="15,7" Margin="10,0,10,0" BorderThickness="0"/>
                        <Button Content="Deactivate" Command="{Binding DeactivateCommand}" Background="#EF4444" Foreground="White" Padding="15,7" BorderThickness="0"/>
                        <Button Content="Activate" Command="{Binding ActivateCommand}" Background="#16A34A" Foreground="White" Padding="15,7" Margin="10,0,0,0" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
