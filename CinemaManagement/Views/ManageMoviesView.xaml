<UserControl
    x:Class="CinemaManagement.Views.ManageMoviesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F6FB">

    <!-- ========================================
         STYLES - Dùng chung toàn bộ giao diện
         ======================================== -->
    <UserControl.Resources>

        <!-- Khung nội dung -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Tiêu đề khu vực -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17253D"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Nhãn nhập liệu -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Ô nhập liệu -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Chọn ngày -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- Nút mặc định -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Nút phụ -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- Nút nguy hiểm -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- Bảng dữ liệu -->
        <Style x:Key="TableStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E2E8F0"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#F1F5F9"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

    </UserControl.Resources>

    <!-- ========================================
         MAIN LAYOUT
         ======================================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#17253D">
            <DockPanel Margin="25,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="CINEMA MANAGEMENT"
                        FontSize="23"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Quản lý phim và báo cáo doanh thu"
                        FontSize="12"
                        Foreground="#CBD5E1"
                        Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1" Margin="16">

            <!-- =================================
                 F11, F12, F13, F14
                 MOVIE MANAGEMENT
                 ================================= -->
            <TabItem Header="Quản lý phim ">

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FORM: ADD / EDIT MOVIE -->
                    <Border Grid.Column="0"
                            Style="{StaticResource Card}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Form title -->
                            <StackPanel Grid.Row="0">
                                <TextBlock
                                    Text="Thông tin phim"
                                    Style="{StaticResource SectionTitle}"/>

                                <TextBlock
                                    Text="Chọn phim trong bảng để sửa, hoặc tạo phim mới."
                                    Foreground="#64748B"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,16"/>
                            </StackPanel>

                            <!-- Form fields -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">

                                <StackPanel Margin="0,0,8,0">

                                    <!-- F11 / F13: Title -->
                                    <TextBlock
                                        Text="Tên phim *"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        MaxLength="200"
                                        Text="{Binding Form.Title,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Genre -->
                                    <TextBlock
                                        Text="Thể loại *"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        MaxLength="100"
                                        Text="{Binding Form.Genre,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Duration -->
                                    <TextBlock
                                        Text="Thời lượng (phút) *"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        Text="{Binding Form.DurationText,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Description -->
                                    <TextBlock
                                        Text="Mô tả phim"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        Height="80"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        Text="{Binding Form.Description,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Age rating -->
                                    <TextBlock
                                        Text="Giới hạn độ tuổi"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        MaxLength="20"
                                        Text="{Binding Form.AgeRating,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Release date -->
                                    <TextBlock
                                        Text="Ngày phát hành"
                                        Style="{StaticResource FieldLabel}"/>

                                    <DatePicker
                                        SelectedDate="{Binding Form.ReleaseDate,
                                            Mode=TwoWay}"/>

                                    <!-- Language -->
                                    <TextBlock
                                        Text="Ngôn ngữ"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        MaxLength="50"
                                        Text="{Binding Form.Language,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Poster -->
                                    <TextBlock
                                        Text="Đường dẫn Poster"
                                        Style="{StaticResource FieldLabel}"/>

                                    <TextBox
                                        MaxLength="500"
                                        Text="{Binding Form.PosterUrl,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                                </StackPanel>
                            </ScrollViewer>

                            <!-- ACTION BUTTONS -->
                            <StackPanel Grid.Row="2"
                                        Margin="0,15,0,0">

                                <Separator Margin="0,0,0,14"/>

                                <!-- F11: CREATE -->
                                <Button
                                    Content="+ Thêm phim"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding AddMovieCommand}"
                                    HorizontalAlignment="Stretch"/>

                                <!-- F13: EDIT -->
                                <Button
                                    Content="Lưu thay đổi"
                                    Style="{StaticResource ActionButton}"
                                    Background="#0D9488"
                                    Command="{Binding EditMovieCommand}"
                                    HorizontalAlignment="Stretch"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- F14: DELETE -->
                                    <Button
                                        Grid.Column="0"
                                        Content="Ngừng hoạt động"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteMovieCommand}"/>

                                    <!-- CLEAR FORM -->
                                    <Button
                                        Grid.Column="1"
                                        Content="Làm mới form"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearFormCommand}"/>
                                </Grid>

                                <TextBlock
                                    Text="* là thông tin bắt buộc"
                                    FontSize="11"
                                    Foreground="#64748B"
                                    Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- F12: MOVIE LIST -->
                    <Border Grid.Column="2"
                            Style="{StaticResource Card}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- List title -->
                            <DockPanel Grid.Row="0"
                                       LastChildFill="True">

                                <Button
                                    DockPanel.Dock="Right"
                                    Content="Làm mới danh sách"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshMoviesCommand}"/>

                                <StackPanel>
                                    <TextBlock
                                        Text="Danh sách phim"
                                        Style="{StaticResource SectionTitle}"
                                        Margin="0,0,0,4"/>

                                    <TextBlock
                                        Text="Xem, chọn và quản lý các phim trong hệ thống"
                                        FontSize="12"
                                        Foreground="#64748B"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Total movies -->
                            <Border Grid.Row="1"
                                    Background="#EFF6FF"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,15,0,12">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="Tổng số phim: "
                                        Foreground="#1E40AF"
                                        FontWeight="Medium"/>

                                    <TextBlock
                                        Text="{Binding TotalMovies}"
                                        Foreground="#1D4ED8"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Movie table -->
                            <DataGrid
                                Grid.Row="2"
                                ItemsSource="{Binding Movies}"
                                SelectedItem="{Binding SelectedMovie,
                                    Mode=TwoWay}"
                                Style="{StaticResource TableStyle}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="ID"
                                        Binding="{Binding MovieId}"
                                        Width="55"/>

                                    <DataGridTextColumn
                                        Header="Tên phim"
                                        Binding="{Binding Title}"
                                        Width="*"
                                        MinWidth="150"/>

                                    <DataGridTextColumn
                                        Header="Thể loại"
                                        Binding="{Binding Genre}"
                                        Width="125"/>

                                    <DataGridTextColumn
                                        Header="Số phút"
                                        Binding="{Binding DurationMinutes}"
                                        Width="75"/>

                                    <DataGridCheckBoxColumn
                                        Header="Hoạt động"
                                        Binding="{Binding IsActive}"
                                        Width="90"/>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Selection info -->
                            <Border Grid.Row="3"
                                    Background="#F8FAFC"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,12,0,0">

                                <StackPanel>
                                    <TextBlock
                                        Text="Phim đang chọn"
                                        FontWeight="SemiBold"
                                        Foreground="#475569"/>

                                    <TextBlock
                                        Text="{Binding SelectedMovie.Title,
                                            TargetNullValue=Chưa chọn phim}"
                                        Foreground="#2563EB"
                                        FontSize="14"
                                        Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- =================================
                 F39 - SALES SUMMARY
                 ================================= -->
            <TabItem Header="Báo cáo doanh thu">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- REPORT TITLE -->
                    <StackPanel Grid.Row="0"
                                Margin="8,5,8,15">

                        <TextBlock
                            Text="Tổng quan doanh thu"
                            FontSize="23"
                            FontWeight="Bold"
                            Foreground="#17253D"/>

                        <TextBlock
                            Text="Theo dõi đơn thanh toán, vé bán và doanh thu."
                            Foreground="#64748B"
                            Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- DATE FILTER -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock
                                Text="Chọn khoảng thời gian"
                                Style="{StaticResource SectionTitle}"/>

                            <WrapPanel>

                                <!-- FROM DATE -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock
                                        Text="Từ ngày"
                                        Style="{StaticResource FieldLabel}"/>

                                    <DatePicker
                                        Width="175"
                                        SelectedDate="{Binding FromDate,
                                            Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- TO DATE -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock
                                        Text="Đến ngày"
                                        Style="{StaticResource FieldLabel}"/>

                                    <DatePicker
                                        Width="175"
                                        SelectedDate="{Binding ToDate,
                                            Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- LOAD REPORT -->
                                <Button
                                    Content="Xem báo cáo"
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding LoadSalesCommand}"/>
                            </WrapPanel>

                            <!-- REPORT MESSAGE -->
                            <TextBlock
                                Text="{Binding ReportMessage}"
                                FontSize="12"
                                Foreground="#64748B"
                                TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                    <!-- STATISTICS -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paid bookings -->
                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">

                            <StackPanel>
                                <TextBlock
                                    Text="ĐƠN ĐÃ THANH TOÁN"
                                    Foreground="#64748B"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="{Binding TotalPaidBookings,
                                        StringFormat={}{0:N0}}"
                                    FontSize="29"
                                    FontWeight="Bold"
                                    Foreground="#17253D"
                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tickets sold -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">

                            <StackPanel>
                                <TextBlock
                                    Text="SỐ VÉ ĐÃ BÁN"
                                    Foreground="#64748B"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="{Binding TotalTickets,
                                        StringFormat={}{0:N0}}"
                                    FontSize="29"
                                    FontWeight="Bold"
                                    Foreground="#17253D"
                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total revenue -->
                        <Border Grid.Column="4"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">

                            <StackPanel>
                                <TextBlock
                                    Text="TỔNG DOANH THU VÉ"
                                    Foreground="#1D4ED8"
                                    FontWeight="SemiBold"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="{Binding TotalRevenue,
                                        StringFormat={}{0:N0} VNĐ}"
                                    FontSize="27"
                                    FontWeight="Bold"
                                    Foreground="#1D4ED8"
                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- REPORT TABLES -->
                    <Border Grid.Row="3"
                            Style="{StaticResource Card}"
                            MinHeight="220">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Text="Chi tiết doanh thu"
                                Style="{StaticResource SectionTitle}"/>

                            <TabControl Grid.Row="1">

                                <!-- GROUPED SUMMARY -->
                                <TabItem Header="Doanh thu theo phim / ngày">

                                    <DataGrid
                                        ItemsSource="{Binding SalesSummary}"
                                        Style="{StaticResource TableStyle}">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn
                                                Header="Ngày"
                                                Binding="{Binding Date,
                                                    StringFormat=dd/MM/yyyy}"
                                                Width="115"/>

                                            <DataGridTextColumn
                                                Header="Tên phim"
                                                Binding="{Binding MovieTitle}"
                                                Width="*"
                                                MinWidth="150"/>

                                            <DataGridTextColumn
                                                Header="Mã phim"
                                                Binding="{Binding MovieId}"
                                                Width="75"/>

                                            <DataGridTextColumn
                                                Header="Số đơn"
                                                Binding="{Binding BookingCount}"
                                                Width="75"/>

                                            <DataGridTextColumn
                                                Header="Số vé"
                                                Binding="{Binding TicketCount}"
                                                Width="75"/>

                                            <DataGridTextColumn
                                                Header="Doanh thu (VNĐ)"
                                                Binding="{Binding Revenue,
                                                    StringFormat=N0}"
                                                Width="150"/>

                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <!-- PAID BOOKINGS -->
                                <TabItem Header="Chi tiết đơn thanh toán">

                                    <DataGrid
                                        ItemsSource="{Binding PaidBookings}"
                                        Style="{StaticResource TableStyle}">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn
                                                Header="Mã đơn"
                                                Binding="{Binding BookingCode}"
                                                Width="145"/>

                                            <DataGridTextColumn
                                                Header="Tên phim"
                                                Binding="{Binding MovieTitle}"
                                                Width="*"
                                                MinWidth="150"/>

                                            <DataGridTextColumn
                                                Header="Ngày thanh toán"
                                                Binding="{Binding PaymentDate,
                                                    StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="160"/>

                                            <DataGridTextColumn
                                                Header="Số vé"
                                                Binding="{Binding TicketCount}"
                                                Width="75"/>

                                            <DataGridTextColumn
                                                Header="Doanh thu (VNĐ)"
                                                Binding="{Binding Revenue,
                                                    StringFormat=N0}"
                                                Width="150"/>

                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>

                            <TextBlock
                                Grid.Row="2"
                                Text="Doanh thu tính theo giá vé tại thời điểm đặt. Không tính đơn và vé đã hủy."
                                FontSize="11"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
